SERVER_PORT=8000
LOG_LEVEL=release
DEBUG=false

ENV=local # mocked storage and clients - use for local development
    
DB_HOST=0.0.0.0
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=spr_mobile
DB_SSL_MODE=disable
DB_MAX_CONNS=15
DB_MAX_IDLE_CONNS=10
DB_MAX_CONN_IDLE_TIME_IN_SECONDS=300
DB_MAX_CONN_LIFETIME_IN_SECONDS=1500
DB_RUNNING_IN_CI=false
UT=60s